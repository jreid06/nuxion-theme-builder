{
    "name": "nuxion-theme-builder",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "nuxt typecheck",
        "test:run": "vitest run",
        "sync:nuxion": "node scripts/syncNuxion.ts",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:run"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.7.0",
        "@pinia/nuxt": "^1.0.2",
        "@tailwindcss/vite": "^4.3.3",
        "nuxt": "^4.6.4",
        "pinia": "^4.0.3",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.13",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.17.0",
        "eslint": "^10.14.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    }
}
