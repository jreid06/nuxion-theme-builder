exports[`renderThemeCss > matches the stored Driftwire output 1`] = `
"/*
 * Driftwire — A ship’s chart room: paper, navy ink and signal flags, where every release is a flag you hoist and can lower again.
 *
 * Starter generated from the theme brief. Sections match Driftwire's:
 *   1. Tokens  2. Frame  3. Art primitives  4. Type and buttons  5. Shipped blocks
 *
 * Every site-wide rule starts with [data-nuxion-theme='driftwire'].
 */

@reference '../../../app/assets/css/main.css';

/* ── 1. Tokens ── */

[data-nuxion-theme='driftwire'] {
    --container-8xl: 76rem;
    --radius-card: 0.25rem;
    --radius-panel: 0.25rem;
    --radius-media: 0.125rem;
    --shadow-media: none;
    --radius-button: 2px;
    --button-border-width: 1px;
    --heading-weight: 500;
}

:root {
    --dw-ground: var(--studio-nuxt-body-color);
    --dw-ink: var(--studio-nuxt-text-color);
    --dw-art-1: var(--studio-nuxt-dw-art-1, #b02a1a);
    --dw-art-2: var(--studio-nuxt-dw-art-2, #1d4f91);
    --dw-art-3: var(--studio-nuxt-dw-art-3, #f2b62b);
    --dw-art-4: var(--studio-nuxt-dw-art-4, #fbf7ee);
    --dw-art-5: var(--studio-nuxt-dw-art-5, #1b6f6f);
    --dw-art-6: var(--studio-nuxt-dw-art-6, #d8c8a4);
}

.dw {
    --dw-line: color-mix(in oklab, currentColor 11%, transparent);
    --dw-line-strong: color-mix(in oklab, currentColor 20%, transparent);
    --dw-muted: color-mix(in oklab, currentColor 76%, transparent);
}

/* ── 2. Frame ── */

/* ── 3. Art primitives ── */

/* alternating graduated blocks, as on a chart’s border */
.dw-scale {
}

/* flat signal-flag panels in hard-edged geometry */
.dw-flag {
}

/* chart depth lines, on a light ground */
.dw-contours {
}

/* ── 4. Type and buttons ── */

@layer components {
    [data-nuxion-theme='driftwire'] .heading-1 {
        font-size: 2.5rem;
        line-height: 1.08;
        letter-spacing: -0.01em;

        @variant md {
            font-size: 4.5rem;
        }
    }

    [data-nuxion-theme='driftwire'] .heading-2 {
        font-size: 2rem;
        line-height: 1.12;
        letter-spacing: -0.005em;

        @variant md {
            font-size: 3.25rem;
        }
    }

    [data-nuxion-theme='driftwire'] .heading-3 {
        font-size: 1.5rem;
        line-height: 1.2;
        letter-spacing: 0;

        @variant md {
            font-size: 1.875rem;
        }
    }

    [data-nuxion-theme='driftwire'] .heading-4 {
        font-size: 1.25rem;
        line-height: 1.25;
        letter-spacing: 0;

        @variant md {
            font-size: 1.5rem;
        }
    }

    [data-nuxion-theme='driftwire'] .nuxion-paragraph {
        font-size: 1rem;
        line-height: 1.6;
        letter-spacing: 0;

        @variant md {
            font-size: 1.0625rem;
        }
    }

    [data-nuxion-theme='driftwire'] .dw-eyebrow {
        font-size: 0.75rem;
        line-height: 1.4;
        letter-spacing: 0.08em;
    }
}

/* ── 5. Shipped blocks, restyled ── */

/* Form field corners */
[data-nuxion-theme='driftwire']
    [data-block='form.block']
    :is(input, textarea, [role='combobox']) {
    border-radius: 2px;
}

/* Ruled lines between items; Questions in the heading font */
[data-nuxion-theme='driftwire'] [data-block='faq'] {
}

/* Quote in the heading font; Flat, no shadows; chart panels */
[data-nuxion-theme='driftwire'] [data-block='testimonials'] {
}

/* Real gaps between cells; chart panels */
[data-nuxion-theme='driftwire'] [data-block='grid.base'] {
}

/* Underlined inputs, no boxes; 2px corners */
[data-nuxion-theme='driftwire'] [data-block='form.block'] {
}
"
`;
